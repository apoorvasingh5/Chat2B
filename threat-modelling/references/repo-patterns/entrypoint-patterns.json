      }
    },
    {
      "id": "mcp-tool-go-sdk",
      "kind": "rpc_tool",
      "language": "Go",
      "dependency_hints": [
        "modelcontextprotocol/go-sdk",
        "mark3labs/mcp-go"
      ],
      "anchor_regex": "\\.AddTool\\(",
      "window_lines": 12,
      "fields": {
        "title": {
          "regex": "Title:\\s*\"([^\"]+)\""
        },
        "name_ref": {
          "regex": "Name:\\s*([A-Za-z0-9_.]+)"
        }
      }
    },
    {
      "id": "mcp-tool-python-sdk-decorator",
      "kind": "rpc_tool",
      "language": "Python",
      "dependency_hints": [
        "mcp",
        "fastmcp"
      ],
      "anchor_regex": "@\\w*\\.?tool\\s*\\(",
      "window_lines": 10,
      "fields": {
        "name_ref": {
          "regex": "^\\s*(?:async\\s+)?def\\s+(\\w+)\\s*\\(",
          "multiline": true
        }
      }
    },
    {
      "id": "mcp-tool-typescript-sdk",
      "kind": "rpc_tool",
      "language": "JavaScript",
      "dependency_hints": [
        "@modelcontextprotocol/sdk"
      ],
      "anchor_regex": "\\.tool\\(\\s*[\"']([^\"']+)[\"']",
      "window_lines": 8,
      "fields": {
        "name_ref": {
          "group": 1
        }
      }
    },
    {
      "id": "grpc-go-service-method",
      "kind": "rpc_method",
      "language": "Go",
      "dependency_hints": [
        "google.golang.org/grpc"
      ],
      "anchor_regex": "func\\s+\\(\\w+\\s+\\*\\w+Server\\)\\s+(\\w+)\\(",
      "window_lines": 10,
      "fields": {
        "method_name": {
          "group": 1
        }
      }
    },
    {
      "id": "grpc-python-servicer-method",
      "kind": "rpc_method",
      "language": "Python",
      "dependency_hints": [
        "grpcio",
        "grpc"
      ],
      "anchor_regex": "class\\s+\\w+Servicer[^:]*:",
      "window_lines": 1,
      "fields": {}
    },
    {
      "id": "grpc-java-service-method",
      "kind": "rpc_method",
      "language": "Java",
      "dependency_hints": [
        "grpc"
      ],
      "anchor_regex": "public\\s+void\\s+(\\w+)\\(\\w+Request",
