{
  "_purpose": "Data-driven registry of 'entry point' detection rules for scripts/scan_repo_surface.py. An entry point is anything an external caller invokes: an HTTP route, an MCP tool, a gRPC method, a message-queue consumer, a CLI command, a scheduled job, a serverless handler. The engine (scan_repo_surface.py) is fully generic -- it has zero framework-specific code. Every framework/protocol it recognizes is a row in this file.",
  "_extend_instructions": "To support a new framework or protocol (gRPC today, Kafka tomorrow, whatever comes after that): add a new object to 'patterns' below following the existing shape. Never add framework-specific regex or branching logic to scan_repo_surface.py itself -- if you find yourself about to write 'if repo uses X, look for Y' in Python, that 'if/look for' belongs here as data instead. A pattern needs: a stable 'id', a 'kind' (reuse an existing kind where the concept matches -- see 'kinds' below -- or introduce a new one), an 'anchor_regex' that finds the entry point's declaration line, optional 'language' (null = language-agnostic, applied across all scanned text files), optional 'dependency_hints' (lowercase substrings matched against scan_repo_manifest.py's detected dependency names -- used to skip irrelevant patterns for precision when a manifest scan is supplied; omit to always apply), 'window_lines' (how many lines after the anchor to search for 'fields'), and 'fields' (named sub-extractions: 'group' takes a capture group from the anchor match itself, 'regex' searches the window for a separate pattern).",
  "kinds": [
    "http_route",
    "rpc_tool",
    "rpc_method",
    "graphql_resolver",
    "message_consumer",
    "cli_command",
    "scheduled_job",
    "serverless_handler"
  ],
  "sensitive_action_keywords": [
    "delete",
    "remove",
    "admin",
    "approve",
    "escalate",
    "grant",
    "revoke",
    "write",
    "update",
    "change",
    "trigger",
    "execute",
    "run",
    "pay",
    "payment",
    "transfer",
    "refund",
    "remediat",
    "risk",
    "severity",
    "override",
    "bypass",
    "disable",
    "shutdown",
    "destroy",
    "purge"
  ],
  "patterns": [
    {
      "id": "rest-flask-decorator",
      "kind": "http_route",
      "language": "Python",
      "dependency_hints": [
        "flask"
      ],
      "anchor_regex": "@(?:app|blueprint|bp)\\.(get|post|put|patch|delete)\\(\\s*[\"']([^\"']+)[\"']",
      "window_lines": 15,
      "fields": {
        "method": {
          "group": 1,
          "upper": true
        },
        "path": {
          "group": 2
        }
      }
    },
    {
      "id": "rest-flask-route-decorator",
      "kind": "http_route",
      "language": "Python",
      "dependency_hints": [
        "flask"
      ],
      "anchor_regex": "@app\\.route\\(\\s*[\"']([^\"']+)[\"'](?:.*methods\\s*=\\s*\\[([^\\]]*)\\])?",
      "window_lines": 15,
      "fields": {
        "path": {
          "group": 1
        },
        "method": {
          "group": 2
        }
      }
    },
    {
      "id": "rest-fastapi-decorator",
      "kind": "http_route",
      "language": "Python",
      "dependency_hints": [
        "fastapi"
      ],
      "anchor_regex": "@(?:app|router)\\.(get|post|put|patch|delete)\\(\\s*[\"']([^\"']+)[\"']",
      "window_lines": 15,
      "fields": {
        "method": {
          "group": 1,
          "upper": true
        },
        "path": {
          "group": 2
        }
      }
    },
    {
      "id": "rest-django-urlpattern",
      "kind": "http_route",
      "language": "Python",
      "dependency_hints": [
        "django"
      ],
      "anchor_regex": "path\\(\\s*[\"']([^\"']*)[\"']\\s*,\\s*(\\w+)",
      "window_lines": 5,
      "fields": {
        "path": {
          "group": 1
        },
        "view": {
          "group": 2
        }
      }
    },
    {
      "id": "rest-express-route",
      "kind": "http_route",
      "language": "JavaScript",
      "dependency_hints": [
        "express"
      ],
      "anchor_regex": "(?:app|router)\\.(get|post|put|patch|delete)\\(\\s*[\"']([^\"']+)[\"']",
      "window_lines": 15,
      "fields": {
        "method": {
          "group": 1,
          "upper": true
        },
        "path": {
          "group": 2
        }
      }
    },
    {
      "id": "rest-spring-mapping",
      "kind": "http_route",
      "language": "Java",
      "dependency_hints": [
        "spring"
      ],
      "anchor_regex": "@(Get|Post|Put|Patch|Delete)Mapping\\(\\s*[\"']?([^\"')]*)[\"']?\\)",
      "window_lines": 15,
      "fields": {
        "method": {
          "group": 1,
          "upper": true
        },
        "path": {
          "group": 2
        }
      }
    },
    {
      "id": "rest-aspnet-attribute",
